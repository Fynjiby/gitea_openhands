# Copied to .env by make-cert.sh, which also fills in SERVER_IP.
#
# SERVER_IP is required: docker-compose.yml builds DOMAIN, ROOT_URL and
# SSH_DOMAIN from it, and refuses to start while it is empty. The certificate
# must cover the same address, so set it through `./make-cert.sh <ip>`
# rather than editing it here.
SERVER_IP=

# Ports published on the host.
WEB_PORT=3001
SSH_PORT=2223
